# ---------------------------------------------------------------------------
# foodtruck-os environment. Copy to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets.
# Money is integer cents; times are UTC in the DB. See docs/02-BUILD-SPEC.md.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public base URL the app is reachable at (used to build the webhook notification URL).
APP_URL=http://localhost:3000

# --- Database (Phase 1) ----------------------------------------------------
# Host dev (`pnpm dev` on the Mac): the ports overlay publishes Postgres on 5433
# and Redis on 6380 (infra/docker-compose.ports.yml). Inside Docker these are
# overridden to the `postgres` / `redis` services automatically.
DATABASE_URL=postgresql://foodtruck:foodtruck@localhost:5433/foodtruck

# --- Redis (Phase 1) — pub/sub + BullMQ ------------------------------------
REDIS_URL=redis://localhost:6380

# --- Square (Phase 2) ------------------------------------------------------
# `sandbox` while testing, `production` when live.
SQUARE_ENVIRONMENT=sandbox
# Personal access token for the single merchant. Treat like a password.
SQUARE_ACCESS_TOKEN=
# sq0idp-... (production) or sandbox-sq0idb-... (sandbox)
SQUARE_APPLICATION_ID=
# The truck's single location, e.g. L8N6...
SQUARE_LOCATION_ID=
# From Developer Dashboard → your app → Webhooks → Subscriptions (created in Phase 2).
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must EXACTLY match the URL configured in the Square webhook subscription.
SQUARE_WEBHOOK_NOTIFICATION_URL=https://api.yourdomain.com/api/webhooks/square

# --- Cloudflare Tunnel (Phase 2) -------------------------------------------
# Public hostname routed to web:3000 via the tunnel.
TUNNEL_HOSTNAME=api.yourdomain.com
# Either use a tunnel token, or mount a credentials JSON at cloudflared/ (gitignored).
CLOUDFLARE_TUNNEL_TOKEN=

# --- Auth (Phase 4) --------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Leave blank: Auth.js then uses the host the browser came in on (localhost,
# the truck LAN IP, or the tunnel). Setting it pins redirects to one URL.
AUTH_URL=
# Victor's email — the single seeded admin for MVP.
INITIAL_ADMIN_EMAIL=
# First login password (8+ chars). On startup the Docker container creates the
# admin with it if that admin has no password yet — it never replaces an
# existing one. Change it later with `pnpm --filter web admin:set-password`.
INITIAL_ADMIN_PASSWORD=
# Docker only: on an EMPTY database, seed the placeholder demo menu (dev). Leave
# unset in production and use "Pull from Square" to import the real menu.
# SEED_DEMO_MENU=1

# --- Email (unused) ----------------------------------------------------------
# Login is email + password since Phase 4 M2; magic-link email is no longer
# sent. Kept only in case email notifications are added later.
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
