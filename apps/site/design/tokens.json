{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Barrio Burger Co. design tokens. PROVISIONAL palette — re-derive from the printed flyers (design/flyers/) when they arrive; see DESIGN.md → Flyer analysis. Implemented in app/globals.css (Tailwind v4 @theme).",
  "color": {
    "mural": {
      "chile": { "$value": "#E5432C", "$description": "rojo chile — primary action; text on it: #14110E (4.6:1)" },
      "marigold": { "$value": "#FFB627", "$description": "cempasúchil — highlights, stickers; text on it: #14110E (10.7:1)" },
      "rosa": { "$value": "#FF5FA8", "$description": "rosa mexicano; text on it: #14110E" },
      "agave": { "$value": "#3DBE6B", "$description": "agave — OPEN; text on it: #14110E (7.9:1)" },
      "anil": { "$value": "#2D5BD7", "$description": "añil — info panels; text on it: #FFFFFF (5.9:1)" },
      "paper": { "$value": "#F7EFE2", "$description": "papel — flyer cards; ink on it #14110E (16.5:1)" },
      "ink": { "$value": "#14110E" },
      "outline": { "$value": "#0B0907", "$description": "mural black outline" }
    },
    "dark": {
      "bg": { "$value": "#1F1915" },
      "surface": { "$value": "#2B231E" },
      "surface-2": { "$value": "#3A2F28" },
      "text": { "$value": "#F7EFE2", "$description": "15.2:1 on bg" },
      "text-muted": { "$value": "#C9BCA8", "$description": "9.3:1 on bg, 8.3:1 on surface" },
      "outline": { "$value": "#0B0907" },
      "shadow": { "$value": "#000000" },
      "accent": { "$value": "{color.mural.chile}" },
      "success": { "$value": "#3DBE6B", "$description": "OPEN, 7.3:1 as text on bg" },
      "warning": { "$value": "#FFB627", "$description": "BACK SOON, 9.9:1" },
      "danger": { "$value": "#FF6A50", "$description": "CLOSED / sold out text, 6.2:1; fill #E5432C" },
      "link": { "$value": "#FFB627" },
      "focus": { "$value": "#FFB627" }
    },
    "light": {
      "bg": { "$value": "#F7EFE2" },
      "surface": { "$value": "#FFFBF3" },
      "surface-2": { "$value": "#EFE4D2" },
      "text": { "$value": "#14110E", "$description": "16.5:1" },
      "text-muted": { "$value": "#5E5248", "$description": "6.6:1" },
      "outline": { "$value": "#14110E" },
      "shadow": { "$value": "#14110E" },
      "accent": { "$value": "{color.mural.chile}" },
      "success": { "$value": "#1F7A45", "$description": "4.7:1" },
      "warning": { "$value": "#8A5A00", "$description": "5.2:1" },
      "danger": { "$value": "#B3261E", "$description": "5.7:1" },
      "link": { "$value": "#2D5BD7" },
      "focus": { "$value": "#2D5BD7" }
    }
  },
  "font": {
    "display": { "$value": "Bowlby One", "$description": "Google Fonts, SIL OFL 1.1 — headlines only, uppercase" },
    "body": { "$value": "Atkinson Hyperlegible Next", "$description": "Google Fonts, SIL OFL 1.1 — menus, prices, forms, legal" },
    "hand": { "$value": "Permanent Marker", "$description": "Google Fonts, Apache 2.0 — annotations, Spanish kickers; sparingly" }
  },
  "fontSize": {
    "xs": { "$value": "0.8125rem" },
    "sm": { "$value": "0.9375rem" },
    "base": { "$value": "1.0625rem", "$description": "17px body for outdoor reading" },
    "lg": { "$value": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)" },
    "h3": { "$value": "clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem)" },
    "h2": { "$value": "clamp(1.75rem, 1.4rem + 1.8vw, 2.75rem)" },
    "h1": { "$value": "clamp(2.25rem, 1.6rem + 3.4vw, 4.25rem)" },
    "hero": { "$value": "clamp(2.75rem, 1.7rem + 5.6vw, 6.5rem)" }
  },
  "spacing": { "$description": "Tailwind's 4px scale (0.25rem steps). Page gutter 16px; section gap 48–64px; card padding 16–24px." },
  "radius": { "sm": { "$value": "3px" }, "md": { "$value": "6px" }, "lg": { "$value": "10px" } },
  "outline": { "thin": { "$value": "2px" }, "base": { "$value": "3px" }, "thick": { "$value": "4px" } },
  "shadowOffset": {
    "$description": "Solid, zero blur, down-right, color = shadow token",
    "sm": { "$value": "3px 3px 0 0" },
    "base": { "$value": "5px 5px 0 0" },
    "lg": { "$value": "8px 8px 0 0" }
  },
  "rotation": {
    "a": { "$value": "-2deg" },
    "b": { "$value": "1.5deg" },
    "c": { "$value": "-1deg" },
    "d": { "$value": "2.5deg" },
    "e": { "$value": "-3deg" }
  },
  "motion": {
    "duration": {
      "press": { "$value": "90ms" },
      "fast": { "$value": "160ms" },
      "base": { "$value": "240ms" },
      "draw": { "$value": "650ms" },
      "openPulse": { "$value": "2400ms" }
    },
    "easing": {
      "out": { "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
      "pop": { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)" }
    }
  },
  "touchTarget": { "min": { "$value": "44px" }, "primary": { "$value": "48px" } }
}
