# ---------------------------------------------------------------------------
# Barrio Burger Co. website (apps/site). Copy to apps/site/.env (gitignored).
# In production set these in Vercel → Project → Settings → Environment Variables.
# Every integration is optional in development: without keys, SMS/email are
# logged (console + message_log), uploads go to public/uploads, and food
# checkout runs in mock mode. Mock modes never run in production.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
# Public URL, no trailing slash (links in texts/emails, QR codes, webhooks).
SITE_URL=http://localhost:3020
# Postgres. Local: the foodtruck-os docker Postgres (port 5433), database
# barrio_site. Vercel: Neon's *pooled* connection string (host contains -pooler).
DATABASE_URL=postgresql://foodtruck:foodtruck@localhost:5433/barrio_site

# --- Admin -----------------------------------------------------------------
# 32+ random chars: openssl rand -base64 33
SESSION_SECRET=
# pnpm --filter site admin:hash-password 'your long password'  → paste output
ADMIN_PASSWORD_HASH=

# --- Square (food orders + menu) ---------------------------------------------
# Same Square account and location as foodtruck-os. sandbox | production
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
# Browser copies for the Web Payments SDK card form (same values).
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
# A SEPARATE webhook subscription for the website (Developer Dashboard →
# Webhooks), URL = ${SITE_URL}/api/webhooks/square, events:
# order.fulfillment.updated, order.updated, catalog.version.updated
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must exactly equal the subscription URL.
SQUARE_WEBHOOK_NOTIFICATION_URL=
# Dev only: accept orders without charging (also automatic when Square isn't set).
# PAYMENTS_MOCK=1

# --- Kitchen load from the truck (optional) --------------------------------
# foodtruck-os public URL (the Cloudflare tunnel), used for the "~N min" wait.
KITCHEN_API_URL=
# Must match KITCHEN_API_TOKEN in foodtruck-os's .env (if set there).
KITCHEN_API_TOKEN=

# --- POS → website status (optional) -----------------------------------------
# Bearer token for POST /api/integrations/status {status, message?}.
SITE_INTEGRATION_TOKEN=

# --- Stripe (merch) ----------------------------------------------------------
# Turn on Stripe Tax (Dashboard → Tax) and register Texas.
STRIPE_SECRET_KEY=
# Webhook endpoint ${SITE_URL}/api/webhooks/stripe, events:
# checkout.session.completed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=
# Flat shipping in cents for shipped merch orders.
MERCH_SHIPPING_CENTS=600

# --- Twilio (SMS) ------------------------------------------------------------
# Needs A2P 10DLC registration for US texting (start early, 1–3 weeks).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Prefer a Messaging Service (Advanced Opt-Out on); or a single FROM number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Messaging Service → Integration → incoming messages webhook:
# ${SITE_URL}/api/webhooks/twilio

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Barrio Burger Co. <hola@yourdomain>"
EMAIL_FROM=

# --- Owner alerts --------------------------------------------------------------
# Where catering leads, gallery submissions and takedown requests are sent.
OWNER_EMAIL=
OWNER_PHONE=

# --- Uploads (Vercel Blob) -----------------------------------------------------
# Vercel → Storage → Blob → connect to the project (sets this automatically).
BLOB_READ_WRITE_TOKEN=

# --- Branding / embeds ---------------------------------------------------------
# Set to 1 after adding public/brand/logo.svg (the hand-drawn logo).
NEXT_PUBLIC_LOGO_READY=
# Optional comma-separated Instagram post URLs for the gallery (load on tap).
INSTAGRAM_EMBED_POST_URLS=
