# Multi-stage build for the web app in a pnpm monorepo.
# Build context is the REPO ROOT (see infra/docker-compose.yml).
#
# The app runs through its custom server (apps/web/server.ts: Next + Socket.IO
# for the KDS + the Square sync worker), which Next's `output: 'standalone'`
# can't serve — so the runtime image keeps the built workspace and runs
# server.ts with tsx, exactly like `pnpm start`.

# --- deps: install workspace dependencies -----------------------------------
FROM node:22-alpine AS deps
RUN corepack enable
WORKDIR /app
# Copy only manifests first for better layer caching.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/package.json
RUN pnpm install --frozen-lockfile

# --- builder: production build --------------------------------------------------
FROM node:22-alpine AS builder
RUN corepack enable
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter web build

# --- runner ----------------------------------------------------------------------
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

# Non-root user.
RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

# The built workspace: sources (server.ts, migrations, scripts), .next, and
# node_modules (tsx is needed at runtime to run the TypeScript server).
COPY --from=builder --chown=nextjs:nodejs /app ./
COPY --chown=nextjs:nodejs infra/entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

USER nextjs
EXPOSE 3000
ENTRYPOINT ["./entrypoint.sh"]
